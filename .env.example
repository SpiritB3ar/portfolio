
# Environment Variables

# Connect to your MongoDB database
# Replace with your actual connection string
DATABASE_URL="mongodb+srv://<usuario>:<password>@cluster0.takprcy.mongodb.net/portfolio?retryWrites=true&w=majority"

# Admin API Key
# Used by the admin panel to authenticate write operations (POST/PUT/DELETE)
# Both vars must have the same value — one for server, one for client
ADMIN_API_KEY="tu_admin_api_key_aqui"
NEXT_PUBLIC_ADMIN_API_KEY="tu_admin_api_key_aqui"

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="tu_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="tu_upload_preset"

# Recruiter assistant (Fase 1 — Gemini). Server only, never NEXT_PUBLIC_*.
# Get a key at https://aistudio.google.com/apikey (restrict it to
# generativelanguage.googleapis.com). Model default: gemini-3.8-flash.
GEMINI_API_KEY=""
ASSISTANT_MODEL="gemini-3.8-flash"
AI_PROVIDER="gemini"
# Resilience cascade: primary (retries) → fallback model → reply cache.
# Empty string disables the fallback model. Defaults shown.
ASSISTANT_FALLBACK_MODEL="gemini-3.8-flash-lite"
ASSISTANT_MAX_ATTEMPTS="3"
ASSISTANT_TIMEOUT_MS="20000"
ASSISTANT_CACHE_TTL_MS="3600000"
