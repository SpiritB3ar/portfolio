{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "build:cf": "prisma generate --no-engine && opennextjs-cloudflare build",
    "preview": "pnpm build:cf && opennextjs-cloudflare preview",
    "deploy": "pnpm build:cf && opennextjs-cloudflare deploy",
    "upload": "pnpm build:cf && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/poiret-one": "^5.2.8",
    "@google/genai": "^2.28.0",
    "@hookform/resolvers": "^3.9.0",
    "@opennextjs/cloudflare": "^1.20.11",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "18.11.9",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.25",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-cloudinary": "^6.17.5",
    "react": "19.3.1",
    "react-datepicker": "^7.3.0",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.52.2",
    "recharts": "2.15.4",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@tanstack/react-query-devtools": "5.101.0",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "postcss": "^8.4.41",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines"
